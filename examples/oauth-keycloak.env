# pg-mcp-server + the Keycloak test realm of docker-compose.yml (tests/oidc/keycloak-realm.json):
#
#   docker compose --env-file examples/oauth-keycloak.env --profile keycloak up -d --build
#
# Admin UI:  http://localhost:3000/admin  -> "Sign in with single sign-on" (users alice / bob / eve / root, password = name;
#            root is an admin). Keycloak admin console: http://localhost:8081 (admin / admin).
# MCP:       get a token for alice and send it as bearer token:
#   curl -s -X POST http://localhost:8081/realms/pg-mcp/protocol/openid-connect/token \
#     -d grant_type=password -d client_id=pgmcp-test -d username=alice -d password=alice
#
# MCP clients that do the OAuth login themselves (Claude Code etc.) use the pre-registered public client pgmcp-mcp-client:
#   claude mcp add --transport http --client-id pgmcp-mcp-client pg http://localhost:3000/mcp
#
# The browser knows Keycloak as localhost:8081 (token issuer), the server container as keycloak:8080, so the endpoints
# are given explicitly instead of discovery.
OAUTH_ISSUER=http://localhost:8081/realms/pg-mcp
OAUTH_AUTHORIZATION_ENDPOINT=http://localhost:8081/realms/pg-mcp/protocol/openid-connect/auth
OAUTH_TOKEN_ENDPOINT=http://keycloak:8080/realms/pg-mcp/protocol/openid-connect/token
OAUTH_JWKS_URI=http://keycloak:8080/realms/pg-mcp/protocol/openid-connect/certs
OAUTH_CLIENT_ID=pgmcp-web
OAUTH_CLIENT_SECRET=pgmcp-web-secret
OAUTH_AUDIENCE=api://pg-mcp
OAUTH_PUBLIC_URL=http://localhost:3000
# Keycloak has no api://…/.default scope: tell MCP clients which scopes to request
OAUTH_RESOURCE_SCOPES=openid profile email
OAUTH_ADMIN_GROUPS=grp-admin
OAUTH_ALLOWED_GROUPS=grp-dba,grp-users
