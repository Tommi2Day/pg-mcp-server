# pg-mcp-server — docker-compose environment
# Copy to .env and adjust values before running `docker compose up -d`.

# ── MCP server ────────────────────────────────────────────────────────────────

# Host port the server listens on (container always uses 3000)
MCP_PORT=3000

# Image used by scripts/run.sh (defaults: tommi2day/pg-mcp-server / latest).
# IMAGE=tommi2day/pg-mcp-server
# IMAGE_TAG=latest

# Container hostname; added as DNS SAN to the self-signed TLS certificate.
# MCP_HOSTNAME=pg-mcp-server

# Name shown in MCP clients (e.g. Claude browser tab) and the Admin UI.
# Default: pg-mcp-server
# MCP_SERVER_NAME=my-production-db

# Admin UI branding (paths inside the container, see docker-compose.yml for the mount):
# stylesheet overriding the color variables, and a logo file (svg/png/jpg/gif/webp) or http(s) URL.
# BRANDING_DIR=./examples/admin-theme
# ADMIN_THEME_CSS=/branding/theme.css
# ADMIN_LOGO=/branding/logo.svg

# Connection parameters MCP clients of the AUTH_TOKEN may send as X-Pg-* headers:
# none (default) | credentials (X-Pg-User/-Password) | full (also host/port/database/ssl).
# File tokens have their own setting (client_connection). See README "Client-supplied connections".
# PG_CLIENT_CONNECTION=none

# Log level: debug | info | warn | error (default: info).
# SQL text of query/execute tool calls is only logged at debug.
# LOG_LEVEL=info

# Admin bearer token for /mcp and /admin/tokens.
# Generate with: openssl rand -hex 32
# Leave empty to disable authentication (development only).
AUTH_TOKEN=

# ── PostgreSQL (default connection) ──────────────────────────────────────────

PG_HOST=postgres-test
PG_PORT=5432
PG_DATABASE=testdb
PG_USER=postgres
PG_PASSWORD=postgres

# PostgreSQL TLS: false | true | verify
PG_SSL=false

# CA certificate for PG_SSL=verify (path inside container)
# PG_SSL_CA_FILE=/certs/pg-ca.crt

# ── TLS (HTTPS) ───────────────────────────────────────────────────────────────

# Set to true to enable HTTPS. Requires a cert volume mounted at /certs.
TLS_ENABLED=false

# Additional SANs for the auto-generated self-signed certificate.
# Example: DNS:myhost.local,IP:192.168.1.10
# TLS_SAN=

# ── OAuth 2.0 / OpenID Connect (Microsoft Entra ID, Keycloak, …) ─────────────
# Alternative to bearer tokens; see docs/oauth.md. Empty OAUTH_ISSUER = off.
# Deny by default: only the groups/users below (or assignments in the admin UI) may use the server.
# With OAuth on and AUTH_TOKEN empty, authentication is NOT disabled.
# Local Keycloak demo: docker compose --env-file examples/oauth-keycloak.env --profile keycloak up -d --build

# Issuer URL. Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# OAUTH_ISSUER=
# App registration / client used for the admin UI login (default audience)
# OAUTH_CLIENT_ID=
# Client secret of the browser login (omit for public clients; PKCE is always used)
# OAUTH_CLIENT_SECRET=
# Accepted "aud" values of access tokens, comma separated (default: OAUTH_CLIENT_ID). Entra: api://<client-id>
# OAUTH_AUDIENCE=
# External URL of this server; redirect URI = <url>/auth/callback (https also sets the cookie Secure flag)
# OAUTH_PUBLIC_URL=https://mcp.example.com
# Scopes advertised to MCP clients (default <audience>/.default, right for Entra; Keycloak: openid profile email)
# OAUTH_RESOURCE_SCOPES=
# Override the discovery document (e.g. when the browser and the server reach the provider under different host names)
# OAUTH_JWKS_URI=
# OAUTH_AUTHORIZATION_ENDPOINT=
# OAUTH_TOKEN_ENDPOINT=
# Claim with the groups (default: groups; Entra app roles: roles)
# OAUTH_GROUPS_CLAIM=groups
# Who may use the server / the admin UI (comma separated; Entra: group object ids; users: e-mail, *@domain or object id)
# OAUTH_ALLOWED_GROUPS=
# OAUTH_ALLOWED_USERS=
# OAUTH_ADMIN_GROUPS=
# OAUTH_ADMIN_USERS=
# Group/user → default connection, as JSON array, e.g.
# OAUTH_ASSIGNMENTS=[{"group":"<group-id>","connection":{"host":"reporting-db","database":"reports","user":"ro"},"client_connection":"none"}]
